{
  "schema": "flprog.webui/1.0",
  "project": {
    "id": "FLE4D-30MT",
    "title": "FLE4D-30MT"
  },
  "transport": {
    "id": "w5500-http-1",
    "port": 80
  },
  "theme": {
    "background": "#111827",
    "card": "#1f2937",
    "text": "#e5e7eb",
    "accent": "#6366f1"
  },
  "packageOutput": "",
  "channels": [
    {
      "id": "network_ip",
      "label": "IP-адрес",
      "type": "text",
      "direction": "publish",
      "source": "FLProgNetworkInterface::localIP",
      "secret": false,
      "index": 0
    },
    {
      "id": "network_ready",
      "label": "Сеть подключена",
      "type": "bool",
      "direction": "publish",
      "source": "FLProgNetworkInterface::isReady",
      "secret": false,
      "index": 1
    },
    {
      "id": "network_mac",
      "label": "MAC-адрес",
      "type": "text",
      "direction": "publish",
      "source": "FLProgNetworkInterface::mac",
      "secret": false,
      "index": 2
    },
    {
      "id": "network_gateway",
      "label": "Шлюз",
      "type": "text",
      "direction": "publish",
      "source": "FLProgNetworkInterface::activeGateway",
      "index": 3
    },
    {
      "id": "network_subnet",
      "label": "Маска подсети",
      "type": "text",
      "direction": "publish",
      "source": "FLProgNetworkInterface::activeSubnet",
      "index": 4
    },
    {
      "id": "device_model",
      "label": "Модель контроллера",
      "type": "text",
      "direction": "publish",
      "source": "FLProgNetworkInterface::deviceModel (attached identity provider)",
      "index": 5
    },
    {
      "id": "firmware_version",
      "label": "Версия прошивки",
      "type": "text",
      "direction": "publish",
      "source": "FLProgNetworkInterface::firmwareVersion (attached identity provider)",
      "index": 6
    },
    {
      "id": "reset_flags",
      "label": "Маска сброса (накопленная)",
      "type": "text",
      "direction": "publish",
      "source": "FLProgWebUiPlatformDiagnostics::readResetFlags",
      "index": 7
    },
    {
      "id": "reset_cause",
      "label": "Расшифровка флагов сброса",
      "type": "text",
      "direction": "publish",
      "source": "FLProgWebUiPlatformDiagnostics::resetDescription",
      "index": 8
    },
    {
      "id": "heap_used",
