{
  "schema": "flprog.webui/1.0",
  "project": {
    "id": "demo_controller",
    "title": "Демонстрационный контроллер"
  },
  "transport": {
    "id": "wifi-http",
    "port": 80
  },
  "theme": {
    "background": "#111827",
    "card": "#1f2937",
    "text": "#e5e7eb",
    "accent": "#6366f1"
  },
  "channels": [
    {
      "id": "temperature",
      "label": "Температура",
      "type": "float",
      "direction": "publish"
    },
    {
      "id": "light",
      "label": "Свет",
      "type": "bool",
      "direction": "duplex"
    },
    {
      "id": "brightness",
      "label": "Яркость",
      "type": "float",
      "direction": "duplex"
    },
    {
      "id": "network_ip",
      "label": "IP-адрес",
      "type": "text",
      "direction": "publish",
      "source": "FLProgNetworkInterface::localIP"
    },
    {
      "id": "network_ready",
      "label": "Сеть",
      "type": "bool",
      "direction": "publish",
      "source": "FLProgNetworkInterface::isReady"
    },
    {
      "id": "wifi_rssi",
      "label": "Сигнал Wi-Fi, dBm",
      "type": "int32",
      "direction": "publish",
      "source": "FLProg Wi-Fi STA RSSI"
    },
    {
      "id": "wifi_ssid",
      "label": "SSID",
      "type": "text",
      "direction": "duplex",
      "source": "FLProg Wi-Fi STA public configuration"
    },
    {
      "id": "network_mac",
      "label": "MAC-адрес",
      "type": "text",
      "direction": "publish",
      "source": "FLProgNetworkInterface::mac"
    },
    {
      "id": "network_gateway",
      "label": "Шлюз",
      "type": "text",
      "direction": "publish",
      "source": "FLProgNetworkInterface::gateway"
    },
    {
      "id": "network_subnet",
      "label": "Маска",
      "type": "text",
      "direction": "publish",
      "source": "FLProgNetworkInterface::subnet"
    },
    {
      "id": "wifi_password",
      "label": "Пароль Wi-Fi",
      "type": "text",
      "direction": "command",
      "source": "FLProgNetworkInterface::setClientPassword",
      "secret": true
    },
    {
      "id": "network_dhcp",
      "label": "DHCP",
      "type": "bool",
      "direction": "duplex",
      "source": "FLProgNetworkInterface::isDhcp/dhcpMode"
    },
    {
      "id": "network_ip_config",
      "label": "Статический IP",
      "type": "text",
      "direction": "duplex",
      "source": "FLProgNetworkInterface::localIP"
    },
    {
      "id": "network_gateway_config",
      "label": "Шлюз",
      "type": "text",
      "direction": "duplex",
      "source": "FLProgNetworkInterface::gateway"
    },
    {
      "id": "network_subnet_config",
      "label": "Маска",
      "type": "text",
      "direction": "duplex",
      "source": "FLProgNetworkInterface::subnet"
    },
    {
      "id": "network_dns",
      "label": "DNS",
      "type": "text",
      "direction": "duplex",
      "source": "FLProgNetworkInterface::dns"
    },
    {
      "id": "network_apply",
      "label": "Применить и переподключить",
      "type": "bool",
      "direction": "command",
      "source": "FLProgNetworkInterface::disconnect/connect"
    },
    {
      "id": "ap_enabled",
      "label": "Точка доступа включена",
      "type": "bool",
      "direction": "duplex",
      "source": "FLProgNetworkInterface::accessPointMode"
    },
    {
      "id": "ap_ready",
      "label": "Точка доступа активна",
      "type": "bool",
      "direction": "publish",
      "source": "FLProgNetworkInterface::accessPointIsReady"
    },
    {
      "id": "ap_ssid",
      "label": "Имя точки доступа",
      "type": "text",
      "direction": "duplex",
      "source": "FLProgNetworkInterface::accessPointSsid"
    },
    {
      "id": "ap_password",
      "label": "Пароль точки доступа",
      "type": "text",
      "direction": "command",
      "source": "FLProgNetworkInterface::setAccessPointPassword",
      "secret": true
    },
    {
      "id": "ap_channel",
      "label": "Канал точки доступа",
      "type": "int32",
      "direction": "duplex",
      "source": "FLProgNetworkInterface::accessPointChannel"
    },
    {
      "id": "ap_hidden",
      "label": "Скрыть SSID",
      "type": "bool",
      "direction": "duplex",
      "source": "FLProgNetworkInterface::accessPointHidden"
    },
    {
      "id": "ap_max_clients",
      "label": "Максимум клиентов",
      "type": "int32",
      "direction": "duplex",
      "source": "FLProgNetworkInterface::accessPointMaxClients"
    },
    {
      "id": "ap_ip",
      "label": "IP точки доступа",
      "type": "text",
      "direction": "duplex",
      "source": "FLProgNetworkInterface::accessPointConfiguredIP"
    },
    {
      "id": "ap_gateway",
      "label": "Шлюз точки доступа",
      "type": "text",
      "direction": "duplex",
      "source": "FLProgNetworkInterface::accessPointConfiguredGateway"
    },
    {
      "id": "ap_subnet",
      "label": "Маска точки доступа",
      "type": "text",
      "direction": "duplex",
      "source": "FLProgNetworkInterface::accessPointConfiguredSubnet"
    },
    {
      "id": "ap_station_count",
      "label": "Подключено клиентов",
      "type": "int32",
      "direction": "publish",
      "source": "FLProgNetworkInterface::accessPointStationCount"
    },
    {
      "id": "ap_live_ip",
      "label": "Текущий IP точки доступа",
      "type": "text",
      "direction": "publish",
      "source": "FLProgNetworkInterface::accessPointIP"
    },
    {
      "id": "ap_pending",
      "label": "Настройки точки доступа применяются",
      "type": "bool",
      "direction": "publish",
      "source": "FLProgNetworkInterface::accessPointConfigurationPending"
    },
    {
      "id": "ap_error",
      "label": "Ошибка точки доступа",
      "type": "int32",
      "direction": "publish",
      "source": "FLProgNetworkInterface::accessPointLastError"
    },
    {
      "id": "ap_apply",
      "label": "Применить точку доступа",
      "type": "bool",
      "direction": "command",
      "source": "FLProgNetworkInterface::accessPointMode"
    },
    {
      "id": "wifi_scan",
      "label": "Сканировать Wi-Fi",
      "type": "bool",
      "direction": "command",
      "source": "FLProgNetworkInterface::startWifiScan"
    },
    {
      "id": "demo_gauge",
      "label": "Температура шкала",
      "type": "float",
      "direction": "publish"
    },
    {
      "id": "demo_progress",
      "label": "Заполнение",
      "type": "float",
      "direction": "publish"
    },
    {
      "id": "demo_number",
      "label": "Уставка",
      "type": "float",
      "direction": "duplex"
    },
    {
      "id": "demo_check",
      "label": "Разрешить работу",
      "type": "bool",
      "direction": "duplex"
    },
    {
      "id": "demo_color",
      "label": "Цвет",
      "type": "text",
      "direction": "duplex"
    },
    {
      "id": "demo_date",
      "label": "Дата",
      "type": "text",
      "direction": "duplex"
    },
    {
      "id": "demo_time",
      "label": "Время",
      "type": "text",
      "direction": "duplex"
    },
    {
      "id": "demo_mode",
      "label": "Режим",
      "type": "text",
      "direction": "duplex"
    },
    {
      "id": "demo_days",
      "label": "Расписание",
      "type": "int32",
      "direction": "duplex"
    }
  ],
  "pages": [
    {
      "id": "main",
      "title": "Главная",
      "widgets": [
        {
          "id": "temperature",
          "type": "indicator",
          "label": "Температура",
          "channel": "temperature",
          "x": 1,
          "y": 1,
          "w": 4,
          "h": 2,
          "icon": "",
          "color": "#6366f1",
          "options": "",
          "min": 0,
          "max": 100,
          "step": 1
        },
        {
          "id": "light",
          "type": "switch",
          "label": "Свет",
          "channel": "light",
          "x": 5,
          "y": 1,
          "w": 4,
          "h": 2,
          "icon": "",
          "color": "#6366f1",
          "options": "",
          "min": 0,
          "max": 100,
          "step": 1
        },
        {
          "id": "brightness",
          "type": "slider",
          "label": "Яркость",
          "channel": "brightness",
          "icon": "☀",
          "color": "#f59e0b",
          "size": "wide",
          "min": 0,
          "max": 255,
          "step": 1,
          "x": 1,
          "y": 3,
          "w": 8,
          "h": 2,
          "options": ""
        }
      ]
    },
    {
      "id": "wifi",
      "title": "Wi-Fi",
      "system": "wifi",
      "widgets": [
        {
          "id": "network_ip",
