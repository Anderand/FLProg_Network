        },
        {
          "id": "network_gateway_config",
          "type": "text-input",
          "channel": "network_gateway_config",
          "label": "Шлюз",
          "x": 4,
          "y": 9,
          "w": 3,
          "h": 2
        },
        {
          "id": "network_subnet_config",
          "type": "text-input",
          "channel": "network_subnet_config",
          "label": "Маска",
          "x": 7,
