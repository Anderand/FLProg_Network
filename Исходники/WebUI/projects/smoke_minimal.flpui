{
  "schema": "flprog.webui/1.0",
  "project": {
    "id": "smoke_minimal",
    "title": "Минимальная проверка Web UI"
  },
  "transport": { "id": "wifi-http", "port": 80 },
  "theme": {
    "background": "#0b1120",
    "card": "#162237",
    "text": "#edf3ff",
    "accent": "#7367ff"
  },
  "channels": [
    { "id": "temperature", "label": "Температура", "type": "float", "direction": "publish" },
    { "id": "light", "label": "Свет", "type": "bool", "direction": "duplex" }
  ],
  "pages": [
    {
      "id": "main",
      "title": "Проверка",
      "widgets": [
        {
          "id": "temperature", "type": "indicator", "label": "Температура",
          "channel": "temperature", "x": 1, "y": 1, "w": 6, "h": 2,
          "min": -40, "max": 125, "step": 0.1, "color": "#7367ff"
        },
        {
          "id": "light", "type": "switch", "label": "Свет",
          "channel": "light", "x": 7, "y": 1, "w": 6, "h": 2,
          "min": 0, "max": 1, "step": 1, "color": "#22c55e"
        }
      ]
    }
  ]
}
