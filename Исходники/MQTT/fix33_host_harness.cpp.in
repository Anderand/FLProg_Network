#include <cstdint>
#include <cstring>
#include <cstdio>
#include <string>
#include <algorithm>
// @CONSTANTS@
static uint32_t clockNow;
uint32_t millis() { return clockNow; }

struct FLProgNetworkHttpClient {
    int _chunkState = FLPROG_HTTP_CHUNK_SIZE_LINE;
    uint32_t _chunkRemaining = 0, _trailerBytes = 0;
    size_t _lineLength = 0, delivered = 0;
    char _line[FLPROG_HTTP_MAX_LINE_LENGTH + 1] = {};
    int error = 0;
    bool done = false;
    static const char* skipSpaces(const char* p) { while (*p==' ' || *p=='\t') ++p; return p; }
    static bool parseHexUnsigned(const char*, uint32_t&);
    void processChunkedByte(uint8_t);
    void deliverBodyByte(uint8_t) { ++delivered; }
    void finishError(int e) { error = e; }
    void finishSuccess() { done = true; }
    void feed(const std::string& data) {
        for (unsigned char c: data) { if (done || error) break; processChunkedByte(c); }
    }
};

struct FLProgNetworkTcpServerClient {
    bool stopped = false;
    size_t allowance = 0;
    size_t write(const uint8_t*, size_t n) { return std::min(n, allowance); }
    void stop() { stopped = true; }
};
struct FLProgNetworkHttpServer {
    struct ClientContext {
        int state = FLPROG_HTTP_SERVER_STATE_SENDING, error = 0;
        uint32_t lastActivityAt = 0;
        uint16_t responseLength = 10, responseOffset = 0;
        uint8_t responseStructured = 0;
        struct {const uint8_t *data=nullptr; size_t offset=0,length=0;} flash;
        bool responseOverflow = false;
        char response[128] = {};
    } _clients[1];
    uint32_t _requestTimeoutMs = 100, _timeoutCount = 0, _events = 0;
    int _error = 0, _badRequestCount = 0, _responseCount = 0;
    size_t _writeBudget = 16;
    FLProgNetworkTcpServerClient* _legacyProcessingClient = nullptr;
    void updateClient(uint8_t, FLProgNetworkTcpServerClient&);
    void flushResponse(uint8_t, FLProgNetworkTcpServerClient&, ClientContext&);
    void queueProtocolError(uint8_t, ClientContext&, int, uint8_t);
    void processInput(uint8_t, FLProgNetworkTcpServerClient&, ClientContext&) {}
    static const char* reasonPhrase(int) { return "Request Timeout"; }
    bool buildStructuredResponse(ClientContext& c, int, const char*, const char*, uint32_t, bool) {
        c.responseLength = 10; return true;
    }
    bool appendResponseProgmem(ClientContext &, const char *, size_t) {return true;}
};

struct FLProgNetworkMqttClient {
    struct Tcp { bool connected() { return true; } } _tcp;
    bool _tcpAttached = true, _cancelRequested = false, _sessionConnected = true;
    bool _wantConnected = true, incomingPublish = true, incomingAck = false;
    int _state = FLPROG_MQTT_STATE_WAIT_PINGRESP;
    uint32_t _responseTimeoutMs = 100, _stateStartedAt = 0, _lastProgressAt = 0;
    uint32_t _lastRxAt = 0, _unknownPacketCount = 0, _reconnectAt = 0;
    uint32_t _pingResponseCount = 0, _events = 0;
    int error = 0;
    bool handlePacket(uint8_t, const uint8_t*, size_t);
    bool handlePingresp(const uint8_t*, size_t);
    void pool();
    bool isAttached() { return true; }
    void processCancelRequest() {}
    void processDisconnectRequest() {}
    void scheduleReconnect(int e) { fail(e); }
    void startTcpConnect() {}
    void serviceTcpConnecting() {}
    void serviceSend() {}
    void serviceConnectedIdle() {}
    static bool timeReached(uint32_t a, uint32_t b) { return (int32_t)(a-b) >= 0; }
    void fail(int e) { error = e; _state = FLPROG_MQTT_STATE_ERROR; }
    bool handleConnack(const uint8_t*, size_t) { _state = FLPROG_MQTT_STATE_CONNECTED; return true; }
    bool handleSuback(const uint8_t*, size_t) { _state = FLPROG_MQTT_STATE_CONNECTED; return true; }
    bool handlePublish(uint8_t, const uint8_t*, size_t) { return true; }
    void serviceReceive() {
        if (incomingPublish) handlePacket(0x30, nullptr, 0);
        if (incomingAck) handlePacket(0xD0, nullptr, 0);
    }
};
// @METHODS@

static int total = 0, failures = 0;
static void check(bool ok, const char* label) {
    ++total; if (!ok) ++failures;
    printf("%s %s\n", ok ? "PASS" : "FAIL", label);
}
int main() {
    for (int n: {1, 510, 511, 4096}) {
        FLProgNetworkHttpClient c;
        for (int i=0; i<n; ++i) c.feed("1\r\nx\r\n");
        c.feed("0\r\n\r\n");
        check(c.done && !c.error && c.delivered == (size_t)n, ("chunks="+std::to_string(n)).c_str());
    }
    {
        FLProgNetworkHttpClient c; c.feed("1;ext=yes\r\nx\r\n0\r\nX-Test: yes\r\n\r\n");
        check(c.done && !c.error && c.delivered==1, "chunk extensions and trailers");
    }
    {
        FLProgNetworkHttpClient c; c.feed("0\r\n");
        for (int i=0; i<400; ++i) c.feed("X: y\r\n");
        check(c.error == FLPROG_HTTP_ERROR_HEADER_TOO_LARGE, "oversized trailers rejected");
    }
    {
        FLProgNetworkHttpClient c; c.feed(std::string(256,'a'));
        check(c.error == FLPROG_HTTP_ERROR_LINE_TOO_LONG, "oversized chunk-size line rejected");
    }
    {
        FLProgNetworkHttpClient c; c.feed("1\r\nx!\n");
        check(c.error == FLPROG_HTTP_ERROR_BAD_CHUNK, "invalid data terminator rejected");
    }
    {
        FLProgNetworkHttpClient c; c.feed("100000000\r\n");
        check(c.error == FLPROG_HTTP_ERROR_BAD_CHUNK, "overflowing chunk length rejected");
    }
    {
        FLProgNetworkHttpServer s; FLProgNetworkTcpServerClient c;
        clockNow=99; s.updateClient(0,c);
        check(!c.stopped, "HTTP write grace window");
        clockNow=100; s.updateClient(0,c);
        check(c.stopped && s._timeoutCount==1 && s._clients[0].state==FLPROG_HTTP_SERVER_STATE_CLOSING,
              "HTTP stalled write closes at deadline");
        s.updateClient(0,c);
        check(s._timeoutCount==1 && s._error==FLPROG_HTTP_SERVER_ERROR_TIMEOUT,
              "HTTP timeout reported once");
    }
    {
        FLProgNetworkHttpServer s; FLProgNetworkTcpServerClient c; c.allowance=1;
        clockNow=90; s.updateClient(0,c); clockNow=180; s.updateClient(0,c);
        check(!c.stopped && s._clients[0].responseOffset==2, "HTTP write progress renews timeout");
    }
    {
        FLProgNetworkHttpServer s; FLProgNetworkTcpServerClient c; s._requestTimeoutMs=0;
        clockNow=100000; s.updateClient(0,c);
        check(!c.stopped, "HTTP explicit disabled timeout preserved");
    }
    {
        FLProgNetworkHttpServer s; FLProgNetworkTcpServerClient c;
        s._clients[0].lastActivityAt=0xfffffff0u; clockNow=84; s.updateClient(0,c);
        check(c.stopped, "HTTP timeout survives millis rollover");
    }
    {
        FLProgNetworkHttpServer s; FLProgNetworkTcpServerClient c;
        s._clients[0].state=FLPROG_HTTP_SERVER_STATE_HEADERS; clockNow=100;
        s.updateClient(0,c); clockNow=101; c.allowance=10; s.updateClient(0,c);
        check(!c.stopped && s._clients[0].responseOffset==10, "408 response gets fresh send window");
        clockNow=1000; s.updateClient(0,c);
        check(c.stopped && s._responseCount==1 && s._timeoutCount==1,
              "completed response closes normally even after a delayed pool");
    }
    for (int state: {FLPROG_MQTT_STATE_WAIT_CONNACK, FLPROG_MQTT_STATE_WAIT_SUBACK, FLPROG_MQTT_STATE_WAIT_PINGRESP}) {
        FLProgNetworkMqttClient m; m._state=state;
        for (clockNow=10; clockNow<=90; clockNow+=10) m.pool();
        check(!m.error, "MQTT pending ACK before deadline");
        clockNow=100; m.pool();
        check(m.error==FLPROG_MQTT_ERROR_TIMEOUT, "MQTT PUBLISH cannot extend ACK deadline");
    }
    {
        FLProgNetworkMqttClient m; m.incomingAck=true; clockNow=99; m.pool();
        check(!m.error && m._state==FLPROG_MQTT_STATE_CONNECTED && m._pingResponseCount==1,
              "valid PINGRESP completes wait");
    }
    {
        FLProgNetworkMqttClient m; m._stateStartedAt=0xfffffff0u; clockNow=84; m.pool();
        check(m.error==FLPROG_MQTT_ERROR_TIMEOUT, "MQTT ACK timeout survives millis rollover");
    }
    {
        FLProgNetworkMqttClient m; m._responseTimeoutMs=0; clockNow=100000; m.pool();
        check(!m.error, "MQTT explicit disabled timeout preserved");
    }
    printf("%d checks, %d failures\n", total, failures);
    return failures ? 1 : 0;
}
