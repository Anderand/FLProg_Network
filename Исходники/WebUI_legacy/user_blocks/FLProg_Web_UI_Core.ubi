<sixx.object sixx.id="0" sixx.type="BlocksLibraryElement" sixx.env="Arduino"><sixx.object sixx.id="1" sixx.type="CodeUserBlock" sixx.env="Arduino" sixx.name="typeClass"><sixx.object sixx.id="2" sixx.type="String" sixx.env="Core" sixx.name="id">b7718712-7802-4532-8b95-721124b1a9d2</sixx.object><sixx.object sixx.id="3" sixx.type="OrderedCollection" sixx.env="Core" sixx.name="blocks"/><sixx.object sixx.id="4" sixx.type="String" sixx.env="Core" sixx.name="label">FLProg Web UI Core</sixx.object><sixx.object sixx.id="5" sixx.type="String" sixx.env="Core" sixx.name="name">FLProg Web UI Core</sixx.object><sixx.object sixx.id="6" sixx.type="OrderedCollection" sixx.env="Core" sixx.name="inputs"/><sixx.object sixx.id="7" sixx.type="OrderedCollection" sixx.env="Core" sixx.name="outputs"/><sixx.object sixx.id="8" sixx.type="OrderedCollection" sixx.env="Core" sixx.name="variables"/><sixx.object sixx.id="9" sixx.type="OrderedCollection" sixx.env="Core" sixx.name="parametrs"/><sixx.object sixx.id="10" sixx.type="OrderedCollection" sixx.env="Core" sixx.name="userLibraries"/><sixx.object sixx.id="11" sixx.type="String" sixx.env="Core" sixx.name="info">Один экземпляр. Самостоятельный FLProg Web UI server на порту 80. Использует сетевой интерфейс Wi-Fi из текущего проекта. Стандартный Web Interface FLProg не требуется.</sixx.object><sixx.object sixx.id="12" sixx.type="CodeUserBlockLoopCodePart" sixx.env="Arduino" sixx.name="loopCodePart"><sixx.object sixx.id="13" sixx.type="String" sixx.env="Core" sixx.name="code"/></sixx.object><sixx.object sixx.id="14" sixx.type="CodeUserBlockSetupCodePart" sixx.env="Arduino" sixx.name="setupCodePart"><sixx.object sixx.id="15" sixx.type="String" sixx.env="Core" sixx.name="code">&#35;if defined&#40;FLPROG_WIFI_INTERFACE1&#41;&#10;flpWebUiBegin&#40;FLPROG_WIFI_INTERFACE1&#41;;&#10;&#35;else&#10;&#35;error &quot;FLProg Web UI Core: add a Wi-Fi interface to the FLProg project&quot;&#10;&#35;endif</sixx.object></sixx.object><sixx.object sixx.id="16" sixx.