{
  "schema": "flprog.webui/1.0",
  "project": {
    "id": "fle4d_current",
    "title": "FLE4D-30MT — текущий тест 1.0.19"
  },
  "transport": {
    "id": "w5500-http-1",
    "port": 80
  },
  "theme": {
    "background": "#111827",
    "card": "#1f2937",
    "text": "#e5e7eb",
    "accent": "#6366f1"
  },
  "polling": {
    "intervalMs": 2000,
    "pauseWhenHidden": true
  },
  "channels": [
    {
      "id": "setpoint",
      "label": "setpoint",
      "type": "float",
      "direction": "duplex",
      "index": 101,
      "source": "user"
    },
    {
      "id": "title",
      "label": "title",
      "type": "text",
      "direction": "duplex",
      "index": 102,
      "source": "user"
    },
    {
      "id": "run",
      "label": "run",
      "type": "bool",
      "direction": "command",
      "index": 103,
      "source": "user"
    },
    {
      "id": "actual",
      "label": "actual",
      "type": "float",
      "direction": "publish",
      "index": 104,
      "source": "user"
    },
    {
      "id": "busy",
      "label": "busy",
      "type": "bool",
      "direction": "publish",
      "index": 105,
      "source": "user"
    },
    {
      "id": "result",
      "label": "result",
      "type": "bool",
      "direction": "publish",
      "index": 106,
      "source": "user"
    },
    {
      "id": "commands",
      "label": "commands",
      "type": "int32",
      "direction": "publish",
      "index": 107,
      "source": "user"
    },
    {
      "id": "system_uptime",
      "label": "Время работы после запуска, с",
      "type": "int32",
      "direction": "publish",
      "index": 22,
      "source": "FLProgWebUiPlatformDiagnostics::millis / 1000"
    },
    {
      "id": "running",
      "label": "running",
      "type": "bool",
      "direction": "publish",
      "index": 109,
      "source": "user"
    },
    {
      "id": "permit",
      "label": "permit",
      "type": "bool",
      "direction": "duplex",
      "index": 110,
      "source": "user"
    },
    {
      "id": "pattern_checks",
      "label": "pattern_checks",
      "type": "int32",
      "direction": "publish",
      "index": 98,
      "source": "test-system"
    },
    {
      "id": "network_ip",
      "label": "IP-адрес",
      "type": "text",
      "direction": "publish",
      "index": 0,
      "source": "FLProgNetworkInterface::localIP"
    },
    {
      "id": "network_ready",
      "label": "Сеть подключена",
      "type": "bool",
      "direction": "publish",
      "index": 1,
      "source": "FLProgNetworkInterface::isReady"
    },
    {
      "id": "network_mac",
      "label": "MAC-адрес",
      "type": "text",
      "direction": "publish",
      "index": 2,
      "source": "FLProgNetworkInterface::mac"
    },
    {
      "id": "network_gateway",
      "label": "Шлюз",
      "type": "text",
      "direction": "publish",
      "index": 3,
      "source": "FLProgNetworkInterface::activeGateway"
    },
    {
      "id": "network_subnet",
      "label": "Маска подсети",
      "type": "text",
      "direction": "publish",
      "index": 4,
      "source": "FLProgNetworkInterface::activeSubnet"
    },
    {
      "id": "device_model",
      "label": "Модель контроллера",
      "type": "text",
      "direction": "publish",
      "index": 5,
      "source": "FLProgNetworkInterface::deviceModel (attached identity provider)"
    },
    {
      "id": "firmware_version",
      "label": "Версия прошивки",
      "type": "text",
      "direction": "publish",
      "index": 6,
      "source": "FLProgNetworkInterface::firmwareVersion (attached identity provider)"
    },
    {
      "id": "reset_cause",
      "label": "Расшифровка флагов сброса",
      "type": "text",
      "direction": "publish",
      "index": 7,
      "source": "FLProgWebUiPlatformDiagnostics::resetDescription"
    },
    {
      "id": "reset_flags",
      "label": "Маска сброса (накопленная)",
      "type": "text",
      "direction": "publish",
      "index": 8,
      "source": "FLProgWebUiPlatformDiagnostics::readResetFlags"
    },
    {
      "id": "heap_used",
      "label": "ОЗУ: динамически занято, байт",
      "type": "text",
      "direction": "publish",
      "index": 9,
      "source": "FLProgWebUiPlatformDiagnostics::readHeap (uordblks)"
    },
    {
      "id": "heap_arena_free",
      "label": "ОЗУ: свободные блоки в выделенном пуле, байт",
      "type": "text",
      "direction": "publish",
      "index": 10,
      "source": "FLProgWebUiPlatformDiagnostics::readHeap (fordblks, not total RAM)"
    },
    {
      "id": "diagnostics_checks",
      "label": "diagnostics_checks",
      "type": "int32",
      "direction": "publish",
      "index": 99,
      "source": "test-system"
    },
    {
      "id": "flash_total",
      "label": "Flash контроллера: всего, байт",
      "type": "text",
      "direction": "publish",
      "index": 11,
      "source": "FLProgWebUiPlatformDiagnostics::readMemory"
    },
    {
      "id": "flash_app_capacity",
      "label": "Flash: доступно приложению, байт",
      "type": "text",
      "direction": "publish",
      "index": 12,
      "source": "FLProgWebUiPlatformDiagnostics::readMemory"
    },
    {
      "id": "flash_app_used",
      "label": "Flash: размер приложения, байт",
      "type": "text",
      "direction": "publish",
      "index": 13,
      "source": "FLProgWebUiPlatformDiagnostics::readMemory"
    },
    {
      "id": "flash_app_free",
      "label": "Flash: свободно для приложения, байт",
      "type": "text",
      "direction": "publish",
      "index": 14,
      "source": "FLProgWebUiPlatformDiagnostics::readMemory"
    },
    {
      "id": "ram_total",
      "label": "ОЗУ контроллера: всего, байт",
      "type": "text",
      "direction": "publish",
      "index": 15,
      "source": "FLProgWebUiPlatformDiagnostics::readMemory"
    },
    {
      "id": "ram_app_capacity",
      "label": "ОЗУ: доступно приложению, байт",
      "type": "text",
      "direction": "publish",
      "index": 16,
      "source": "FLProgWebUiPlatformDiagnostics::readMemory"
    },
    {
      "id": "ram_static_used",
      "label": "ОЗУ: переменные программы, байт",
      "type": "text",
      "direction": "publish",
      "index": 17,
      "source": "FLProgWebUiPlatformDiagnostics::readMemory"
    },
    {
      "id": "ram_available_estimate",
      "label": "ОЗУ: доступно для выделений (оценка), байт",
      "type": "text",
      "direction": "publish",
      "index": 18,
      "source": "FLProgWebUiPlatformDiagnostics::readMemory"
    },
    {
      "id": "ram_used_estimate",
      "label": "ОЗУ: занято и зарезервировано (оценка), байт",
      "type": "text",
      "direction": "publish",
      "index": 19,
      "source": "FLProgWebUiPlatformDiagnostics::readMemory"
    },
    {
      "id": "ccm_total",
      "label": "Дополнительная ОЗУ CCM: всего, байт",
      "type": "text",
      "direction": "publish",
      "index": 20,
      "source": "FLProgWebUiPlatformDiagnostics::readMemory"
    },
    {
      "id": "ccm_used",
      "label": "Дополнительная ОЗУ CCM: занято, байт",
      "type": "text",
      "direction": "publish",
      "index": 21,
      "source": "FLProgWebUiPlatformDiagnostics::readMemory"
    }
  ],
  "pages": [
    {
      "id": "main",
      "title": "Управление",
      "widgets": [
        {
          "id": "permit_switch",
          "type": "checkbox",
          "label": "Разрешить управление (RAM-тест)",
          "channel": "permit",
          "icon": "",
          "color": "",
          "min": 0.0,
          "max": 1.0,
          "step": 1.0,
          "x": 1,
          "y": 1,
          "w": 12,
          "h": 2,
          "options": "",
          "code": "",
          "group": "Разрешение ПЛК",
          "placeholder": "",
          "unit": "",
          "maxLength": 63,
          "confirmation": "",
          "pattern": "",
          "validationMessage": ""
        },
        {
          "id": "setpoint_field",
          "type": "number-input",
          "label": "Уставка",
          "channel": "setpoint",
          "icon": "",
          "color": "",
          "min": 0.0,
          "max": 100.0,
          "step": 0.5,
          "x": 1,
          "y": 1,
          "w": 4,
          "h": 2,
          "options": "",
          "code": "",
          "group": "Поля ввода",
          "placeholder": "От 0 до 100",
          "unit": "°C",
          "maxLength": 20,
          "confirmation": "",
          "pattern": "",
          "validationMessage": "",
          "bindings": [
            {
              "role": "enabled",
              "channel": "permit",
              "direction": "publish"
            }
          ]
        },
        {
          "id": "title_field",
          "type": "text-input",
          "label": "Тестовое имя",
          "channel": "title",
          "icon": "",
          "color": "",
          "min": 0.0,
          "max": 100.0,
          "step": 1.0,
          "x": 5,
          "y": 1,
          "w": 4,
          "h": 2,
          "options": "",
          "code": "",
          "group": "Поля ввода",
          "placeholder": "Имя до 30 байт UTF-8",
          "unit": "",
          "maxLength": 30,
          "confirmation": "",
          "pattern": "[A-Z]{2}-[0-9]{3}",
          "validationMessage": "Введите код вида AB-123"
        },
        {
          "id": "actual_value",
          "type": "text",
          "label": "Применённая уставка",
          "channel": "actual",
          "icon": "",
          "color": "",
          "min": 0.0,
          "max": 100.0,
          "step": 1.0,
          "x": 9,
          "y": 1,
          "w": 4,
          "h": 2,
          "options": "",
          "code": "",
          "group": "Поля ввода",
          "placeholder": "",
          "unit": "°C",
          "maxLength": 63,
          "confirmation": "",
          "pattern": "",
          "validationMessage": ""
        },
        {
          "id": "run_button",
          "type": "button",
          "label": "Тестовая команда",
          "channel": "run",
          "icon": "",
          "color": "",
          "min": 0.0,
          "max": 100.0,
          "step": 1.0,
          "x": 1,
          "y": 1,
          "w": 4,
          "h": 2,
          "options": "",
          "code": "",
          "group": "Команды",
          "placeholder": "",
          "unit": "",
          "maxLength": 63,
          "confirmation": "Выполнить тестовую команду в памяти? Выходы ПЛК не меняются.",
          "pattern": "",
          "validationMessage": "",
          "bindings": [
            {
              "role": "enabled",
              "channel": "permit",
              "direction": "publish"
            },
            {
              "role": "busy",
              "channel": "busy",
              "direction": "publish"
            },
            {
              "role": "result",
              "channel": "result",
              "direction": "publish"
            }
          ]
        },
        {
          "id": "running_value",
          "type": "indicator",
          "label": "Тестовый флаг",
          "channel": "running",
          "icon": "",
          "color": "",
          "min": 0.0,
          "max": 100.0,
          "step": 1.0,
          "x": 5,
          "y": 1,
          "w": 4,
          "h": 2,
          "options": "",
          "code": "",
          "group": "Команды",
          "placeholder": "",
          "unit": "",
          "maxLength": 63,
          "confirmation": "",
          "pattern": "",
          "validationMessage": ""
        },
        {
          "id": "count_value",
          "type": "text",
          "label": "Выполнено команд",
          "channel": "commands",
          "icon": "",
          "color": "",
          "min": 0.0,
          "max": 100.0,
          "step": 1.0,
          "x": 9,
          "y": 1,
          "w": 4,
          "h": 2,
          "options": "",
          "code": "",
          "group": "Команды",
          "placeholder": "",
          "unit": "",
          "maxLength": 63,
          "confirmation": "",
          "pattern": "",
          "validationMessage": ""
        }
      ],
      "groupStyles": {
        "Разрешение ПЛК": {
          "border": true,
          "padding": 20,
          "gap": 14
        },
        "Поля ввода": {
          "border": true,
          "padding": 12,
          "gap": 8
        },
        "Команды": {
          "border": false,
          "padding": 4,
          "gap": 4
