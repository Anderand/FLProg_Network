{
  "schema": "flprog.webui/1.0",
  "project": {
    "id": "new_project",
    "title": "Новый проект"
  },
  "transport": {
    "id": "wifi-http",
    "port": 80
  },
  "theme": {
    "background": "#111827",
    "card": "#1f2937",
    "text": "#e5e7eb",
    "accent": "#6366f1"
  },
  "packageOutput": "E:\\FLP\\Flprog_network\\flprog_webui_next\\project_packages",
  "channels": [
    {
      "id": "network_ip",
      "label": "IP-адрес",
      "type": "text",
      "direction": "publish",
      "source": "FLProgNetworkInterface::localIP",
      "secret": false,
      "index": 0
    },
    {
      "id": "network_ready",
      "label": "Сеть подключена",
      "type": "bool",
      "direction": "publish",
      "source": "FLProgNetworkInterface::isReady",
      "secret": false,
      "index": 1
    },
    {
      "id": "wifi_rssi",
      "label": "Сигнал Wi-Fi, dBm",
      "type": "int32",
      "direction": "publish",
      "source": "FLProg Wi-Fi STA RSSI",
      "secret": false,
      "index": 2
    },
    {
      "id": "wifi_ssid",
      "label": "SSID",
      "type": "text",
      "direction": "duplex",
      "source": "FLProg Wi-Fi STA public configuration",
      "secret": false,
      "index": 3
    },
    {
      "id": "network_mac",
      "label": "MAC-адрес",
      "type": "text",
      "direction": "publish",
      "source": "FLProgNetworkInterface::mac",
      "secret": false,
      "index": 4
    },
    {
      "id": "network_gateway",
      "label": "Шлюз",
      "type": "text",
      "direction": "publish",
      "source": "FLProgNetworkInterface::gateway",
      "secret": false,
      "index": 5
    },
    {
      "id": "network_subnet",
      "label": "Маска подсети",
      "type": "text",
      "direction": "publish",
      "source": "FLProgNetworkInterface::subnet",
      "secret": false,
      "index": 6
    },
    {
      "id": "wifi_password",
      "label": "Пароль Wi-Fi",
      "type": "text",
      "direction": "command",
      "source": "FLProgNetworkInterface::setClientPassword",
      "secret": true,
      "index": 7
    },
    {
      "id": "network_dhcp",
      "label": "DHCP",
      "type": "bool",
      "direction": "duplex",
      "source": "FLProgNetworkInterface::isDhcp/dhcpMode",
      "secret": false,
      "index": 8
    },
    {
      "id": "network_ip_config",
      "label": "Статический IP",
      "type": "text",
      "direction": "duplex",
      "source": "FLProgNetworkInterface::localIP",
      "secret": false,
      "index": 9
    },
    {
      "id": "network_gateway_config",
      "label": "Шлюз",
      "type": "text",
      "direction": "duplex",
      "source": "FLProgNetworkInterface::gateway",
      "secret": false,
      "index": 10
    },
    {
      "id": "network_subnet_config",
      "label": "Маска",
      "type": "text",
      "direction": "duplex",
      "source": "FLProgNetworkInterface::subnet",
      "secret": false,
      "index": 11
    },
    {
      "id": "network_dns",
      "label": "DNS",
      "type": "text",
      "direction": "duplex",
      "source": "FLProgNetworkInterface::dns",
      "secret": false,
      "index": 12
    },
    {
      "id": "network_apply",
      "label": "Применить и переподключить",
      "type": "bool",
      "direction": "command",
      "source": "FLProgNetworkInterface::disconnect/connect",
      "secret": false,
      "index": 13
    }
  ],
